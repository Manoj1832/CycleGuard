# Environment Variables
# Copy this file to .env and fill in your values.

PORT=3000

# MQTT Broker (EMQX Cloud)
MQTT_HOST=j22792b7.ala.eu-central-1.emqxsl.com
MQTT_PORT=8883
MQTT_USERNAME=cycleguard
MQTT_PASSWORD=Change me

# Environment
NODE_ENV=development

# CORS — allowed frontend origins (comma-separated)
# Development: http://localhost:5500,http://127.0.0.1:5500
# Production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Security & PIN
# Generate PIN_HASH with: node backend/scripts/hashPin.js [your-pin]
PIN_HASH=
# Optional setup token to authorize registering new passkeys without entering PIN
SETUP_TOKEN=
# Development fallback PIN (only if PIN_HASH is not set)
DEFAULT_PIN=

# WebAuthn / Passkeys
RP_NAME=CycleGuard
RP_ID=localhost
EXPECTED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://localhost:3000
AUTH_MOCK_MODE=false
LOCKOUT_SECONDS=30

# Persistent storage for passkeys + device state (credentials.json / state.json).
# On Render, attach a Disk and set this to its mount path, e.g. /var/data
# Without it, everything is wiped on each deploy / restart.
DATA_DIR=

# Firebase Push Notifications (Optional)
# Paste the contents of your Firebase Service Account JSON here (single-line or escaped)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT=
