# Production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# PIN (prototype only — move to hashed storage for production)
DEFAULT_PIN=2873

# WebAuthn / Passkeys
